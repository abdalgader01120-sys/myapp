[app]
title = Jaddo Proxy
package.name = jaddoproxy
package.domain = org.jaddo
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,pem
version = 0.1
requirements = python3,kivy,cryptography,openssl
orientation = portrait
fullscreen = 0
android.permissions = INTERNET
android.api = 30
android.minapi = 21
android.ndk = 28c
android.archs = arm64-v8a, armeabi-v7a
